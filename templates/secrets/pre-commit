#!/usr/bin/env bash
# Pre-commit hook: block the commit if staged changes contain a secret.
# Installed by `bash scripts/install-git-hooks.sh`.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed: brew install gitleaks" >&2
  exit 1   # a missing scanner is how leaks happen, so fail loud
fi

root="$(git rev-parse --show-toplevel)"
if ! gitleaks git --pre-commit --staged --redact --no-banner \
     --config "$root/.gitleaks.toml" "$root"; then
  echo >&2
  echo "Commit blocked: a secret-shaped value is staged." >&2
  echo "  Real secret → unstage it and move it into the right env file." >&2
  echo "  False positive → add a narrow allowlist entry to .gitleaks.toml with a reason." >&2
  exit 1
fi
